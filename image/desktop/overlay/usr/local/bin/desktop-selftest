#!/bin/bash
# desktop-selftest - product assertions run by the shared live smoke test.

set -uo pipefail

failures=0

check() {
    local label="$1"
    shift
    if "$@" >/dev/null 2>&1; then
        echo "  ok   $label"
    else
        echo "  FAIL $label" >&2
        failures=$((failures + 1))
    fi
}

echo "acof selftest"

check "Acof runs" acof version
check "the workspace is writable" test -w /workspace
# Acof is stateless; the one persisted path is its config dir (saved key + any
# config.yaml) under ~/.config/acof.
check "the config directory is writable" test -w "${HOME}/.config/acof"
# `acof config` writes the provider key into ~/.config/acof/config.yaml,
# which acof reads directly - there is no env-export hook.
check "acof config resolves a path" acof config path

if [ "$failures" -gt 0 ]; then
    echo "acof selftest: $failures failed" >&2
    exit 1
fi

echo "acof selftest: Acof is ready"
